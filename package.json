{
  "name": "agentwikis-mcp",
  "version": "0.2.1",
  "description": "MCP server for Agent Wikis (agentwikis.com) \u2014 maintained, agent-readable knowledge bases with calibrated search and provenance. Read-only; free without a key, and an Agent Wikis Pro key adds the XL tier.",
  "type": "module",
  "bin": {
    "agentwikis-mcp": "index.js"
  },
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonbistudio/agentwikis-mcp.git"
  },
  "homepage": "https://agentwikis.com/for-agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "knowledge-base",
    "llms-txt",
    "agents",
    "documentation"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "overrides": {
    "ajv": {
      "fast-uri": "4.1.5"
    }
  }
}
